---
import globalStyles from '../styles/global.css?inline';
import { projects } from '../data/projects';
const title = 'A small world — Interactive portfolio';
const description = 'Explore a home, Delft, a tabletop dungeon, robotics and website projects.';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#09141b"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{canonical && <link rel="canonical" href={canonical}/>}<style is:inline set:html={globalStyles}></style></head>
<body>
<header class="hud"><a href="#main" class="brand">A SMALL WORLD<span>AN INTERACTIVE PORTFOLIO</span></a><div class="toolbar"><button id="home" hidden>Home</button><button id="overview" hidden>View all</button><button id="skip-intro" hidden>Skip intro</button><button id="pause" hidden>Pause motion</button><button id="directory">Projects ↗</button></div></header>
<main id="main"><div id="lab-viewport" aria-label="Interactive 3D world. Use the room navigation for keyboard access to doors and projects." role="img"></div><div id="loading" role="status" hidden><span class="loading-line"></span><h1>Opening a small world.</h1><p>A place for the things I build and enjoy.</p></div>
<div class="scene-caption" id="scene-caption" hidden><span class="eyebrow" id="room-kicker">DELFT / THE NETHERLANDS</span><h1 id="room-title">Welcome home.</h1><p id="room-subtitle">Hover to discover. Click to explore.</p></div>
<div id="tooltip" hidden></div><p id="announcement" role="status" class="sr-only"></p>
<div id="scene-fade" hidden></div><footer class="controls" hidden id="controls"><span>DRAG TO ORBIT · SCROLL TO ZOOM</span><nav id="room-actions" aria-label="Room navigation"></nav></footer>
<noscript><p class="fallback">The interactive lab needs JavaScript. All projects are available below.</p></noscript><section id="work" class="fallback"><h1>Selected work</h1><article id="scenerie"><p class="eyebrow">01 / SHOPIFY</p><h2>{projects.scenerie.name}</h2><p>A hobby shop for tabletop miniatures, scenery, plants and terrain, paints, and hobby materials.</p><p>{projects.scenerie.contribution}</p><a href={projects.scenerie.url}>Visit the shop ↗</a></article><article id="cyto"><p class="eyebrow">02 / LIGHTING</p><h2>{projects.cyto.name}</h2><p>A circadian-lighting and red-light device company.</p><p>{projects.cyto.contribution}</p><a href={projects.cyto.url}>Visit the website ↗</a></article>{[projects.diginova,projects.shuttle,projects.lumen].map(p=><article><h2>{p.name}</h2>{p.contribution && <p>{p.contribution}</p>}<a href={p.url}>Visit website ↗</a></article>)}</section>
</main>
<dialog id="project-dialog" aria-labelledby="dialog-title"><button id="close-dialog" aria-label="Close project">✕</button><p id="dialog-kicker" class="eyebrow"></p><h2 id="dialog-title"></h2><a id="dialog-image-link" hidden><picture><source id="dialog-webp" type="image/webp"/><img id="dialog-image" width="1100" height="619" decoding="async"/></picture></a><p id="dialog-copy"></p><p id="dialog-role"></p><a id="floo-link" href="https://www.garage2020.nl/projecten/floo/" hidden>Explore FLOo ↗</a><a id="dialog-link">Visit website ↗</a><button id="dialog-action" hidden></button></dialog>
<script>
import { projects } from '../data/projects';
const $ = <T extends HTMLElement>(id:string) => document.getElementById(id) as T;
const dialog=$<HTMLDialogElement>('project-dialog');
let lastFocus:HTMLElement|null=null;
const entries=[
 {title:projects.scenerie.name,kicker:'01 / MINIATURE WORLD',copy:'A Shopify hobby shop for tabletop miniatures, scenery, plants and terrain, paints, and hobby materials.',role:projects.scenerie.contribution,url:projects.scenerie.url},
 {title:projects.cyto.name,kicker:'02 / LIGHT STATION',copy:'A circadian-lighting and red-light device company.',role:projects.cyto.contribution,url:projects.cyto.url},
 {title:projects.diginova.name,kicker:'03 / ROBOTICS',copy:'Robots in practice: DigiNova’s work with social robots, including Pepper and care applications. Explore the website or follow the FLOo project reference.',role:projects.diginova.contribution,url:projects.diginova.url},
 {title:projects.shuttle.name,kicker:'04 / CITY IN MOTION',copy:'Explore the Delft City Shuttle website and its electric shuttle service around Delft.',role:projects.shuttle.contribution,url:projects.shuttle.url},
 {title:projects.lumen.name,kicker:'05 / SCREENING ROOM',copy:'Filmhuis Lumen in Delft. Click the screen image to visit the cinema website.',role:projects.lumen.contribution,url:projects.lumen.url},
 {title:'Hylke Hellinga',kicker:'ABOUT ME',copy:'I like gaming, coding, desktop ricing, drumming, hiking, and Aura liquor.',role:'At the desk: three monitors, a Kinesis Advantage360 keyboard, Neovim, and ChatGPT.',url:'https://github.com/Simbaclaws',image:'https://github.com/Simbaclaws.png?size=512'},
 {title:'Coffee break',kicker:'MAKE YOURSELF AT HOME',copy:'A small pause between coding, games, and the next project.',role:'',url:''},
];
let lab: Awaited<ReturnType<typeof import('../scripts/lab')['mountLab']>>|undefined;

function open(index:number){$('tooltip').hidden=true;lastFocus=document.activeElement as HTMLElement;const e=entries[index];const imageNames=['scenery-en-zo','cyto', 'diginova','shuttle','lumen','',''];const shot=imageNames[index];const imageLink=$<HTMLAnchorElement>('dialog-image-link');const image=$<HTMLImageElement>('dialog-image');imageLink.hidden=!shot&&!e.image;imageLink.classList.toggle('profile-photo',!!e.image);if(shot){imageLink.href=e.url;imageLink.setAttribute('aria-label','Visit '+e.title);$<HTMLSourceElement>('dialog-webp').srcset=import.meta.env.BASE_URL+'images/'+shot+'.webp';image.src=import.meta.env.BASE_URL+'images/'+shot+'.jpg';image.alt=e.title+' website screenshot';}else if(e.image){imageLink.href=e.url;imageLink.setAttribute('aria-label','Visit '+e.title+' on GitHub');$<HTMLSourceElement>('dialog-webp').removeAttribute('srcset');image.src=e.image;image.alt=e.title+' GitHub profile photo';}$('floo-link').hidden=index!==2;$('dialog-title').textContent=e.title;$('dialog-kicker').textContent=e.kicker;$('dialog-copy').textContent=e.copy;$('dialog-role').textContent=e.role;const link=$<HTMLAnchorElement>('dialog-link');link.hidden=!e.url;link.href=e.url;link.textContent=index===5?'Visit GitHub ↗':'Visit website ↗';const action=$<HTMLButtonElement>('dialog-action');action.hidden=true;dialog.showModal();}
$('close-dialog').onclick=()=>dialog.close();dialog.addEventListener('close',()=>lastFocus?.focus());dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close();}});
$('directory').onclick=()=>{document.body.classList.toggle('directory-open');$('directory').setAttribute('aria-expanded',String(document.body.classList.contains('directory-open')));};
$('loading').hidden=false;
async function start(){try{
 const {mountLab}=await import('../scripts/lab');
 lab=mountLab($('lab-viewport'),()=>{document.body.classList.remove('immersive');['loading','controls','scene-caption','home','overview','pause','tooltip','skip-intro'].forEach(id=>$(id).hidden=true);$('announcement').textContent='3D unavailable. Project links are available.';});
 lab.onAction=action=>{if(action.startsWith('project:'))open(Number(action.split(':')[1]));else open(action==='about'?5:6);};
 lab.onHover=(text,x,y)=>{const tip=$('tooltip');tip.hidden=!text;tip.textContent=text+' ↗';tip.style.left=Math.max(8,Math.min(x+18,innerWidth-300))+'px';tip.style.top=Math.max(85,y-40)+'px';};
 lab.onRoom=(id,world)=>{$('room-title').textContent=world.title;$('room-subtitle').textContent=world.subtitle;$('room-kicker').textContent=id==='delft'?'DELFT / EXPLORE THE TOWN':'A SMALL WORLD / '+id.toUpperCase();$('announcement').textContent='Entered '+world.title;const nav=$('room-actions');nav.replaceChildren();world.actions.forEach(item=>{const button=document.createElement('button');button.textContent=item.label;button.onclick=()=>lab?.dispatch(item.action);nav.append(button);});};
 lab.onIntro=playing=>{$('skip-intro').hidden=!playing;$('controls').hidden=playing;$('home').hidden=playing;if(playing){$('room-title').textContent='A little piece of Delft.';$('room-subtitle').textContent='Follow the red hat. We are going home.';}};
 lab.onFade=fade=>{$('scene-fade').hidden=!fade;};
 document.body.classList.add('immersive');$('loading').hidden=true;['scene-caption','controls','home','overview','pause'].forEach(id=>$(id).hidden=false);
 const update=()=>{$('pause').textContent=lab?.paused?'Resume motion':'Pause motion';$('pause').setAttribute('aria-pressed',String(lab?.paused));};lab.onChange=update;update();$('pause').onclick=()=>{lab?.toggle();update();};$('home').onclick=()=>lab?.go('house');$('overview').onclick=()=>lab?.overview();$('skip-intro').onclick=()=>lab?.skipIntro();
}catch{$('loading').hidden=true;$('announcement').textContent='The world could not load. Browse the projects below.';}}
// Begin the separately bundled scene after the HTML shell gets its first paint.
requestAnimationFrame(()=>requestAnimationFrame(start));
</script></body></html>
